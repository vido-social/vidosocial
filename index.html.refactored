            <div class="field"><label for="phone">Puhelinnumero</label><input id="phone" name="phone" autocomplete="tel" inputmode="tel" minlength="5" maxlength="40" required /></div>
            <div class="field"><label for="need">Mitä tarvitsette?</label><select id="need" name="need"><option>Verkkosivusto</option><option>Jatkuva sisällöntuotanto</option><option>Verkkosivusto + sisältö</option><option>En tiedä vielä</option></select></div>
            <div class="field"><label for="message">Lyhyt kuvaus tilanteesta</label><textarea id="message" name="message" maxlength="2000" placeholder="Esim. nykyinen sivu on vanha ja referenssit puuttuvat."></textarea></div>
            <div class="honeypot" aria-hidden="true"><label for="website">Verkkosivu</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
            <input type="hidden" name="startedAt" id="started-at" />
            <button class="btn btn-primary" type="submit">Lähetä kartoituspyyntö <span class="arrow">↗</span></button>
