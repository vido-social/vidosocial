# VIDO Social — Environment Variables Template
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# Email Service (choose one)
# For Resend: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# For SendGrid: https://sendgrid.com
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email recipient for contact form submissions
CONTACT_EMAIL_TO=ville@vidosocial.com

# Calendar & Contact Links
CALENDLY_URL=https://calendly.com/vidosocial
WHATSAPP_NUMBER=+358xxxxxxxxx

# Analytics (optional, privacy-respecting options only)
# PLAUSIBLE_DOMAIN=vidosocial.com

# Environment
NODE_ENV=production
